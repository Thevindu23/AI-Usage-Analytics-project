	measure 'Respondents' = DISTINCTCOUNT('AI Usage'[User_ID])
		formatString: #,##0
		lineageTag: 2abe4848-1100-589e-83f9-b8239452e2d4

	measure 'Average Daily AI Hours' = AVERAGE('AI Usage'[AI_Usage_Hours_Per_Day])
		formatString: 0.00
		lineageTag: 3d5dbe5e-d1ce-5e7e-894c-dad266fc1b62

	measure 'Average Weekly Time Saved' = AVERAGE('AI Usage'[Time_Saved_Hours_Per_Week])
		formatString: 0.00
		lineageTag: e88ac75d-341b-583a-bd48-b95432752ec8

	measure 'Average Productivity Score' = AVERAGE('AI Usage'[Productivity_Score])
		formatString: 0.00
		lineageTag: 4dc6fe8e-a994-5c4b-8672-7c6861142088

	measure 'Average Satisfaction Score' = AVERAGE('AI Usage'[Satisfaction_Score])
		formatString: 0.00
		lineageTag: f2735d76-8822-5482-b71a-e8e85ec2c4ab

	measure 'Total Recommendations Yes' = CALCULATE(COUNTROWS('AI Usage'), 'AI Usage'[Would_Recommend] = "Yes")
		formatString: #,##0
		lineageTag: d2b634cb-e69c-5f52-aada-8acf70a1bbc3

	measure 'Valid Recommendation Responses' = CALCULATE(COUNTROWS('AI Usage'), NOT ISBLANK('AI Usage'[Would_Recommend]))
		formatString: #,##0
		lineageTag: 9bff2120-9e06-5975-9520-01fa6f5a55e0

	measure 'Recommend Yes Rate' = DIVIDE([Total Recommendations Yes], [Valid Recommendation Responses])
		formatString: 0.0%
		lineageTag: 0816c80b-4cb3-570e-aba0-15b0350766d9

	measure 'Recorded Tool Users' = CALCULATE(COUNTROWS('AI Usage'), NOT ISBLANK('AI Usage'[AI_Tool]))
		formatString: #,##0
		lineageTag: ea1220a7-c0f7-58bc-83f2-d62e36ee9c90

	measure 'Usage Hours per Respondent' = MAX('AI Usage'[AI_Usage_Hours_Per_Day])
		formatString: 0.0
		lineageTag: 33b511ae-5ff4-5014-8a18-4a52a3eed802

	measure 'Productivity per Respondent' = MAX('AI Usage'[Productivity_Score])
		formatString: 0.0
		lineageTag: 74d4cf81-aad9-54d8-883e-09700acf248c

	measure 'Valid Time Savings Responses' = COUNT('AI Usage'[Time_Saved_Hours_Per_Week])
		formatString: #,##0
		lineageTag: 29a65e7b-baac-5253-933a-ca14149b5c21

